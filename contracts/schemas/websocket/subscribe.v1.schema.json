{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpp.local/schemas/websocket/subscribe.v1.schema.json",
  "title": "WebSocket subscribe request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "request_id", "channels"],
  "properties": {
    "type": { "const": "subscribe" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(portfolio|tenant|schedule):[^:]+(?::[^:]+)?$" }
    },
    "resume_after": { "type": ["string", "null"], "pattern": "^[0-9]{16}$" }
  }
}

