{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpp.local/schemas/commands/command-requested.v1.schema.json",
  "title": "Device command request",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "schema_version", "command_id", "idempotency_key", "tenant_id", "device_id",
    "action", "parameters", "not_before", "expires_at", "safety_config_version", "created_at"
  ],
  "properties": {
    "schema": { "const": "vpp.command.requested" },
    "schema_version": { "const": 1 },
    "command_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "schedule_id": { "type": ["string", "null"], "maxLength": 128 },
    "schedule_version": { "type": ["integer", "null"], "minimum": 1 },
    "action": { "type": "string", "enum": ["SET_POWER", "STOP", "SET_ACTIVE_POWER_LIMIT", "SET_CHARGE_LIMIT", "PAUSE", "RESUME"] },
    "parameters": { "type": "object", "additionalProperties": true },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "safety_config_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
