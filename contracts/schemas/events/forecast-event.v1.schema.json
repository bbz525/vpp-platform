{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpp.local/schemas/events/forecast-event.v1.schema.json",
  "title": "Forecast run terminal event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "event_id", "event_type", "tenant_id", "forecast_run_id",
    "target_type", "target_id", "forecast_date", "metric", "status", "data_cutoff", "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "enum": ["FORECAST_SUCCEEDED", "FORECAST_INSUFFICIENT_DATA", "FORECAST_FAILED"] },
    "tenant_id": { "type": "string", "format": "uuid" },
    "forecast_run_id": { "type": "string", "format": "uuid" },
    "forecast_version_id": { "type": "string", "format": "uuid" },
    "target_type": { "type": "string", "enum": ["SITE", "PORTFOLIO"] },
    "target_id": { "type": "string", "format": "uuid" },
    "forecast_date": { "type": "string", "format": "date" },
    "metric": { "type": "string", "enum": ["LOAD_KW", "PV_POWER_KW"] },
    "status": { "type": "string", "enum": ["SUCCEEDED", "INSUFFICIENT_DATA", "FAILED"] },
    "failure_code": { "type": "string", "minLength": 1, "maxLength": 80 },
    "data_cutoff": { "type": "string", "format": "date-time" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
