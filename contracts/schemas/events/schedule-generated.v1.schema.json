{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpp.local/schemas/events/schedule-generated.v1.schema.json",
  "title": "Schedule Generated V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "event_id", "event_type", "tenant_id", "schedule_id", "portfolio_id", "schedule_date", "status", "feasibility", "occurred_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "SCHEDULE_GENERATED" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "schedule_id": { "type": "string", "format": "uuid" },
    "portfolio_id": { "type": "string", "format": "uuid" },
    "schedule_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["VALIDATED", "FAILED"] },
    "feasibility": { "type": "string", "enum": ["FEASIBLE", "INFEASIBLE", "FAILED"] },
    "schedule_version_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
